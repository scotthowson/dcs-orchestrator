# =============================================================================
# DCS Orchestrator — ignore rules
# Everything the framework writes at runtime stays out of git. Only the
# template files that ship with the repository are tracked.
# =============================================================================

# ── Local configuration (contains secrets) ──────────────────────────────────
.env
!.env.example
# Per-stack .env files are templates, not secrets
!Stacks/*/.env
*.bak
*.bak.*

# ── Runtime state written by the API server ─────────────────────────────────
# .api-auth/ holds users, session tokens, invites, audit logs and caches.
# Only the four empty JSON templates below are tracked.
.api-auth/*
!.api-auth/alerts.json
!.api-auth/automations.json
!.api-auth/notifications.json
!.api-auth/update-history.json
.data/
.secrets/
.compose-history/

# ── Plugin runtime state ────────────────────────────────────────────────────
.plugins/*/state/
.plugins/*/execution.log
.plugins/*/.disabled

# ── Logs ────────────────────────────────────────────────────────────────────
logs/*
!logs/.gitkeep
*.log
*.jsonl

# ── Persistent container data ───────────────────────────────────────────────
App-Data/

# ── Editors and tooling ─────────────────────────────────────────────────────
.claude/settings.local.json
.vs/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Plugins installed at runtime (catalogue or git); the bundled four stay tracked
.plugins/*/
!.plugins/deploy-notifier/
!.plugins/example-card/
!.plugins/health-watchdog/
!.plugins/traefik-subdomain-guard/
Stacks/*/.dcs-trusted-templates
# a hub's copy of a VM stack: the note that says where it runs, the link to the VM's App-Data
Stacks/*/RUNS-IN-A-VM.txt
Stacks/*/VM-App-Data
.env.lock
.env.tmp.*
