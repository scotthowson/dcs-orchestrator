#!/bin/bash
# =============================================================================
# dcs-grubcfg — writes /boot/grub/grub.cfg for the kernels in /boot: the newest first (the default), the older ones behind it.
# No image has update-grub (Debian and Ubuntu carry grub-common only), so this is what follows the kernels everywhere: on Debian
# and Ubuntu the kernel packages' hooks /etc/kernel/postinst.d and postrm.d/zz-dcs-grubcfg (vm-images/apt/overlay), on Fedora the
# kernel-install plugin 95-dcs-boot.install, on Arch the pacman hook 99-dcs-grubcfg.hook. assemble.sh uses it for the first file
# of every image. The settings are the ones in /etc/default/grub.d/*.cfg. DCS_ROOT (a directory) exists for the tests and the build.
# =============================================================================
set -u
R="${DCS_ROOT:-}"
GRUB_CMDLINE_LINUX=""; GRUB_CMDLINE_LINUX_DEFAULT=""; GRUB_SERIAL_COMMAND="serial --unit=0 --speed=115200"
for f in "$R"/etc/default/grub.d/*.cfg; do [[ -f "$f" ]] && . "$f"; done
CMDLINE="root=LABEL=dcs-root ro $GRUB_CMDLINE_LINUX_DEFAULT $GRUB_CMDLINE_LINUX"
OUT="$R/boot/grub/grub.cfg"; mkdir -p "$R/boot/grub"

# The newest kernel first. Debian, Ubuntu and Fedora put the version in the file name (vmlinuz-6.12.48+deb13-cloud-amd64); Arch names the
# kernel package (vmlinuz-linux, vmlinuz-linux-lts): its version is the name of the directory under /usr/lib/modules whose pkgbase is that name.
sortkey() {
    local n=$1 d
    if [[ $n == [0-9]* ]]; then echo "$n"; return; fi
    for d in "$R"/usr/lib/modules/*/pkgbase; do
        [[ -f $d && "$(cat "$d" 2>/dev/null)" == "$n" ]] && { basename "$(dirname "$d")"; return; }
    done
    echo "$n"
}
# Of two kernels with the same version, the full one goes before the cloud one (Debian): installing linux-image-amd64 next to
# linux-image-cloud-amd64 is how a VM gets USB and GPU drivers, so it is the one meant to boot.
kernels=(); while IFS= read -r k; do kernels+=("${k##*|}"); done < <(
    for f in "$R"/boot/vmlinuz-*; do [[ -f $f ]] || continue; n=${f##*/vmlinuz-}; key=$(sortkey "$n")
        printf '%s|%s|%s\n' "${key/-cloud-/-}" "$([[ $n == *-cloud-* ]] && echo 0 || echo 1)" "$n"; done | sort -t'|' -k1,1Vr -k2,2nr)
[[ ${#kernels[@]} -gt 0 ]] || { echo "dcs-grubcfg: no kernel in $R/boot" >&2; exit 1; }

{
    echo "set default=0"
    echo "set timeout=0"
    echo "if $GRUB_SERIAL_COMMAND; then"
    echo "    terminal_input serial console"
    echo "    terminal_output serial console"
    echo "fi"
    n=0
    for kv in "${kernels[@]}"; do
        initrd=""
        for c in "initrd.img-$kv" "initramfs-$kv.img"; do [[ -f "$R/boot/$c" ]] && { initrd=$c; break; }; done
        [[ -n "$initrd" ]] || continue
        title="DCS"; [[ $n -gt 0 ]] && title="DCS (kernel $kv)"
        printf "menuentry '%s' {\n    search --no-floppy --label --set=root dcs-root\n    linux /boot/vmlinuz-%s %s\n    initrd /boot/%s\n}\n" "$title" "$kv" "$CMDLINE" "$initrd"
        n=$((n + 1))
    done
} > "$OUT.tmp" && mv -f "$OUT.tmp" "$OUT"
[[ -z "${DCS_ROOT:-}" ]] && sync
echo "dcs-grubcfg: ${#kernels[@]} kernel(s) in ${OUT}"
